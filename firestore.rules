rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function anonymous() {
      return signedIn()
        && request.auth.token.firebase.sign_in_provider == 'anonymous';
    }

    function staff() {
      return signedIn()
        && request.auth.token.email != null
        && request.auth.token.email_verified == true
        && request.auth.token.firebase.sign_in_provider == 'password'
        && request.auth.token.email in [
          'eric.carlson.2@bemidjistate.edu',
          'chase.cornell@bemidjistate.edu',
          'andrew.graham@bemidjistate.edu',
          'nick.lowery@bemidjistate.edu'
        ];
    }

    function reportRateCountersValid() {
      let userPath = /databases/$(database)/documents/reportRateUsers/$(request.auth.uid);
      let globalPath = /databases/$(database)/documents/reportRateGlobal/reports;
      let userAfter = getAfter(userPath);
      let globalAfter = getAfter(globalPath);

      return staff() || (
        anonymous()
        && userAfter != null
        && globalAfter != null
        && userAfter.data.uid == request.auth.uid
        && userAfter.data.day == request.time.date()
        && userAfter.data.updatedAt == request.time
        && userAfter.data.count is int
        && userAfter.data.count >= 1
        && userAfter.data.count <= 10
        && globalAfter.data.day == request.time.date()
        && globalAfter.data.updatedAt == request.time
        && globalAfter.data.count is int
        && globalAfter.data.count >= 1
        && globalAfter.data.count <= 100
      );
    }

    match /machines/{machineId} {
      allow read: if signedIn();
      allow create, update, delete: if staff();
    }

    match /machineStatus/{machineId} {
      allow read: if signedIn();

      allow create, update: if
        request.resource.data.keys().hasOnly([
          'machineId',
          'status',
          'pendingReportId',
          'updatedAt'
        ])
        && request.resource.data.machineId == machineId
        && request.resource.data.status in [
          'Operational',
          'Report Pending',
          'Attention',
          'Out of Service'
        ]
        && request.resource.data.pendingReportId is string
        && request.resource.data.updatedAt == request.time
        && (
          staff()
          ||
          (
            anonymous()
            && request.resource.data.status == 'Report Pending'
            && getAfter(
              /databases/$(database)/documents/reports/$(request.resource.data.pendingReportId)
            ).data.machineId == machineId
            && getAfter(
              /databases/$(database)/documents/reports/$(request.resource.data.pendingReportId)
            ).data.submittedByUid == request.auth.uid
            && getAfter(
              /databases/$(database)/documents/reports/$(request.resource.data.pendingReportId)
            ).data.status == 'Open'
          )
        );

      allow delete: if staff();
    }

    match /reports/{reportId} {
      allow create: if signedIn()
        && request.resource.data.keys().hasOnly([
          'machineId','createdAt','urgency','usable','issue','attempted','contact',
          'resource','status','machineNameSnapshot','roomSnapshot',
          'submittedByUid','submittedByEmail'
        ])
        && request.resource.data.submittedByUid == request.auth.uid
        && request.resource.data.createdAt == request.time
        && request.resource.data.machineId is string
        && exists(/databases/$(database)/documents/machines/$(request.resource.data.machineId))
        && request.resource.data.urgency in ['Low','Medium','High','Critical']
        && request.resource.data.usable in ['Yes','Partially','No']
        && request.resource.data.issue is string
        && request.resource.data.issue.size() > 0
        && request.resource.data.issue.size() <= 3000
        && request.resource.data.attempted is string
        && request.resource.data.attempted.size() <= 2000
        && request.resource.data.contact is string
        && request.resource.data.contact.size() <= 250
        && request.resource.data.resource is string
        && request.resource.data.resource.size() <= 1000
        && request.resource.data.status == 'Open'
        && request.resource.data.machineNameSnapshot is string
        && request.resource.data.machineNameSnapshot.size() <= 250
        && request.resource.data.roomSnapshot is string
        && request.resource.data.roomSnapshot.size() <= 250
        && request.resource.data.submittedByEmail is string
        && request.resource.data.submittedByEmail.size() <= 320
        && reportRateCountersValid();

      allow read, update, delete: if staff();
    }

    match /reportRateUsers/{uid} {
      allow get: if (anonymous() && request.auth.uid == uid) || staff();
      allow list: if staff();

      allow create: if anonymous()
        && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['uid','day','count','updatedAt'])
        && request.resource.data.uid == uid
        && request.resource.data.day == request.time.date()
        && request.resource.data.count is int
        && request.resource.data.count == 1
        && request.resource.data.updatedAt == request.time;

      allow update: if anonymous()
        && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['uid','day','count','updatedAt'])
        && request.resource.data.uid == uid
        && resource.data.uid == uid
        && request.resource.data.day == request.time.date()
        && request.resource.data.count is int
        && request.resource.data.count >= 1
        && request.resource.data.count <= 10
        && request.resource.data.updatedAt == request.time
        && (
          (resource.data.day == request.time.date()
            && request.resource.data.count == resource.data.count + 1)
          ||
          (resource.data.day != request.time.date()
            && request.resource.data.count == 1)
        );

      allow delete: if staff();
    }

    match /reportRateGlobal/{counterId} {
      allow get: if signedIn() && counterId == 'reports';
      allow list: if staff();

      allow create: if anonymous()
        && counterId == 'reports'
        && request.resource.data.keys().hasOnly(['day','count','updatedAt'])
        && request.resource.data.day == request.time.date()
        && request.resource.data.count is int
        && request.resource.data.count == 1
        && request.resource.data.updatedAt == request.time;

      allow update: if anonymous()
        && counterId == 'reports'
        && request.resource.data.keys().hasOnly(['day','count','updatedAt'])
        && request.resource.data.day == request.time.date()
        && request.resource.data.count is int
        && request.resource.data.count >= 1
        && request.resource.data.count <= 100
        && request.resource.data.updatedAt == request.time
        && (
          (resource.data.day == request.time.date()
            && request.resource.data.count == resource.data.count + 1)
          ||
          (resource.data.day != request.time.date()
            && request.resource.data.count == 1)
        );

      allow delete: if staff();
    }

    match /repairs/{repairId} {
      allow read, create, update, delete: if staff();
    }

    // Shared master material/pricing records.
    // Everyone using the app may read them, but only authorized staff
    // may change the permanent shared prices.
    match /materials/{materialId} {
      allow read: if signedIn();

      allow create, update: if staff()
        && request.resource.data.keys().hasOnly([
          'name',
          'method',
          'rate',
          'finishGroup',
          'active',
          'demo',
          'updatedAt',
          'updatedBy'
        ])
        && request.resource.data.name is string
        && request.resource.data.name.size() > 0
        && request.resource.data.name.size() <= 150
        && request.resource.data.method in [
          'sqin',
          'gram',
          'each',
          'sheetMetalTier'
        ]
        && request.resource.data.rate is number
        && request.resource.data.rate >= 0
        && request.resource.data.rate <= 10000
        && request.resource.data.finishGroup in [
          'none',
          'wood',
          'sheet',
          'printed',
          'metal',
          'print'
        ]
        && request.resource.data.active is bool
        && request.resource.data.demo is bool
        && request.resource.data.updatedAt == request.time
        && request.resource.data.updatedBy == request.auth.token.email;

      allow delete: if staff();
    }

    // Shared special pricing rules, currently the sheet-metal tiers.
    match /pricingConfig/{configId} {
      allow read: if signedIn();

      allow create, update: if staff()
        && configId == 'sheetMetalTiers'
        && request.resource.data.keys().hasOnly([
          'tiers',
          'updatedAt',
          'updatedBy'
        ])
        && request.resource.data.tiers is list
        && request.resource.data.tiers.size() <= 20
        && request.resource.data.updatedAt == request.time
        && request.resource.data.updatedBy == request.auth.token.email;

      allow delete: if staff();
    }

    // Private machine-specific email routing.
    // Students cannot read stakeholder names or email addresses.
    match /notificationRoutes/{machineId} {
      allow read, create, update, delete: if staff();
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
